# Copy this file to .env and edit the copy. Never place secrets in this template.
BLUEVERSE_ENV=development
PORTAL_API_PORT=8787
PORTAL_WEB_PORT=4173

# When the portal runs in Docker Desktop, host.docker.internal points to Windows/macOS.
# Replace these with LAN addresses when a service runs on another computer.
OLLAMA_URL=http://host.docker.internal:11434
OPEN_WEBUI_URL=http://host.docker.internal:3000
COMFYUI_URL=http://host.docker.internal:8188

# Add real credentials only to your untracked .env file when features require them.
BLUEVERSE_API_KEY=
